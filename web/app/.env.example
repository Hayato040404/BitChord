# Chromium extension id. Development builds pin it with the manifest `key`
# (see web/extension/wxt.config.ts), so this value matches every unpacked
# install. A Chrome Web Store build gets its own id; set it here for that build.
VITE_EXTENSION_ID_CHROMIUM=

# Listen Together server (https://host). Required: `vite build` fails without
# it. Production sets it in the Cloudflare Pages environment.
VITE_PARTY_SERVER_URL=

# Where the Android app banner points on mobile browsers.
VITE_ANDROID_APP_URL=https://github.com/kushagrasinghx/BitChord/releases/latest

# The relay that plays YouTube without the extension (web/docs/deploy.md).
# Empty means this origin: Cloudflare Pages and `vite dev`/`vite preview`
# serve /api/yt, /api/media and /api/lyrics themselves. A plain static host
# (GitHub Pages) has no server, so point this at `node web/relay/server.mjs`
# somewhere.
VITE_RELAY_BASE_URL=

# GitHub Pages only: the path the site is served from. It becomes Vite's
# `base`, and the app routes under it. Leave unset for every other host.
# BITCHORD_BASE=/BitChord/
